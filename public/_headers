# Cloudflare Pages response headers.
#
# I. Caching strategy
#
# 1. Vite fingerprints every file in `assets/`, so those URLs are immutable and
#    can be cached for a year. This is what keeps the ~530 kB Three.js chunk from
#    being re-downloaded on the next deploy.
# 2. `index.html` must never be cached: it is the only file whose name does not
#    change between deploys, and a stale copy would keep pointing browsers at the
#    previous asset hashes.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
