# ---------------------------------------------------------------------------
# Application (exposed to the browser)
#
# Vite only inlines variables prefixed with VITE_. Everything below is read by
# `src/config/env.ts` and validated with Zod at boot, so a typo produces a clear
# startup message instead of a silent `undefined`.
# ---------------------------------------------------------------------------

# Shown in the browser tab and on the main menu.
VITE_APP_TITLE=My MC v2

# Whether the developer overlay (FPS, draw calls, chunk counts) starts visible.
# Press F3 in game to toggle it.
VITE_DEBUG_OVERLAY=true

# Seed used when the player creates a world without typing one.
# Leave empty to generate a random seed for every new world.
VITE_DEFAULT_WORLD_SEED=

# ---------------------------------------------------------------------------
# Deployment (server side only — never prefixed with VITE_ so that the value is
# never bundled into the client)
# ---------------------------------------------------------------------------

# Cloudflare API token with the "Cloudflare Pages: Edit" permission.
# Used by `wrangler pages deploy` and by the deploy GitHub Actions workflow.
CLOUDFLARE_API_TOKEN=

# Cloudflare account id that owns the Pages project.
CLOUDFLARE_ACCOUNT_ID=

# Pages project name; must match `name` in wrangler.toml.
CF_PAGES_PROJECT_NAME=my-mc-v2

# ---------------------------------------------------------------------------
# Local E2E overrides
# ---------------------------------------------------------------------------

# Point the Playwright suite at an already running server instead of starting
# `vite preview` itself.
# E2E_BASE_URL=http://127.0.0.1:4173

# Directory the visual suite writes screenshots into.
# VISUAL_OUTPUT_DIR=test-results/visual
